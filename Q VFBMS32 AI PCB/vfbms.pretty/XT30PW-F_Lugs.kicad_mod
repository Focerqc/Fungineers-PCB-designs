  (pad "TAB1" thru_hole circle (at 3.742 -5.5) (size 2.4 2.4) (drill 1.3) (layers "*.Cu" "*.Mask"))
  (pad "TAB2" thru_hole circle (at 3.742 5.5) (size 2.4 2.4) (drill 1.3) (layers "*.Cu" "*.Mask"))
  (model "${KIPRJMOD}/3dmodels/XT30PW-F.step"
