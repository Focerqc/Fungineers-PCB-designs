(version 1)
(rule "castellated_pads"
    (constraint edge_clearance (min -2mm))
    (condition "A.Type == 'pad'"))

(rule "castellated_entry"
    (constraint edge_clearance (min -2mm))
    (condition "A.Type == 'track' && (A.NetName == '+5V' || A.NetName == 'GND' || A.NetName == 'HALL_U' || A.NetName == 'HALL_V' || A.NetName == 'HALL_W')"))
