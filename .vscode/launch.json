{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Start PCB Dashboard (Board Boxes)",
      "type": "node-terminal",
      "request": "launch",
      "command": "python '${workspaceFolder}/_tools/pcb_dashboard/server.py'",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Open PCB Dashboard in Edge",
      "type": "msedge",
      "request": "launch",
      "url": "http://localhost:5180"
    },
    {
      "name": "Open PCB Dashboard in Chrome",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5180"
    }
  ]
}
