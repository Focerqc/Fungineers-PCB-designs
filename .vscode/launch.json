{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Start PCB Dashboard (Board Boxes)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/_tools/pcb_dashboard/server.py",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Open PCB Dashboard in Edge",
      "type": "msedge",
      "request": "launch",
      "url": "http://localhost:5180"
    },
    {
      "name": "Open PCB Dashboard in Chrome",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5180"
    }
  ]
}
